  "news": [
    {
      "id": 1,
      "category": "Siguranță electrică",
      "title": "Reguli de siguranță electrică în timpul vacanței de toamnă",
      "date": "2026-10-27",
      "description": "Recomandări pentru copii și părinți în apropierea liniilor și instalațiilor electrice.",
      "image": "https://rednord.md/storage/app/public/25278/v.png",
      "safetyRules": [
        "Nu vă apropiați și nu atingeți niciodată conductoarele electrice rupte sau căzute la pământ.",
        "Nu vă apropiați de posturile de transformare sau de alte instalații electrice.",
        "Nu urcați pe stâlpii liniilor electrice și nu aruncați obiecte pe conductoarele electrice.",
        "Nu vă jucați cu zmee, drone sau alte jucării zburătoare în apropierea liniilor electrice.",
        "Nu urcați în copacii aflați în apropierea liniilor electrice și nu încercați să culegeți fructe din aceștia.",
        "Nu vă adăpostiți de ploaie sub copaci aflați în apropierea liniilor electrice sau în posturile de transformare.",
        "Nu atingeți aparatele electrice cu mâinile ude și nu utilizați echipamente electrice deteriorate."
      ],
      "warning": "Dacă observați un conductor electric căzut la pământ, păstrați o distanță de cel puțin 8 metri, nu încercați să-l atingeți sau să-l îndepărtați și anunțați imediat un adult.",
      "closing": "Dragi copii, vă dorim o vacanță de toamnă frumoasă, plină de bucurii și, mai presus de toate, în siguranță!"
    },
    {
      "id": 2,
      "category": "Siguranță electrică",
      "title": "Ce trebuie să faci dacă observi un conductor electric căzut la pământ?",
      "date": "2026-10-22",
      "description": "Un conductor căzut poate rămâne sub tensiune. Ține distanța, nu îl atinge și nu lăsa pe nimeni să se apropie.",
      "image": "https://rednord.md/storage/app/public/25170/6ad9f800b176a_Format-site-2000x1000.jpg",
      "content": "RED-Nord recomandă păstrarea unei distanțe de cel puțin 10 metri față de conductorul căzut. Nu atinge conductorul, obiectele aflate în contact cu el și nu încerca să remediezi defecțiunea. Avertizează persoanele din apropiere și anunță grupul de deservire; dacă există pericol iminent pentru viața oamenilor, apelează 112."
    },
    {
      "id": 3,
      "category": "Cooperare energetică",
      "title": "RED-Nord și Moldelectrica au semnat Convenția de interacțiune",
      "date": "2026-11-04",
      "description": "Acordul stabilește modul de colaborare și coordonare dintre operatorii de distribuție și transport al energiei electrice.",
      "image": "https://www.rednord.md/storage/app/public/25523/IMG_5781.jpg",
      "content": "Convenția clarifică responsabilitățile celor doi operatori, procedurile de coordonare și schimbul de informații tehnice. Colaborarea vizează dirijarea operativă, planificarea funcționării rețelelor și gestionarea situațiilor care pot afecta alimentarea cu energie electrică."
    },
    {
      "id": 4,
      "category": "Investiții în rețea",
      "title": "Lucrări de modernizare finalizate în raionul Șoldănești",
      "date": "2026-10-30",
      "description": "În Alcedar au fost modernizate branșamente și reconstruită o porțiune de linie electrică aeriană.",
      "image": "https://rednord.md/storage/app/public/25411/1.jpg",
      "content": "Conform Planului de investiții 2026, în satul Alcedar au fost modernizate 62 de branșamente și reconstruiți 3,204 km de linie electrică aeriană de 0,4 kV. În orașul Șoldănești a fost montat și un sector de 193 m de linie subterană de 10 kV. Valoarea totală a lucrărilor a fost de 674.077,98 lei."
    }
  ],
